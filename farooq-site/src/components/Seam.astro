---
import { profile } from '../data/profile';
---

<div class="seam">
  <img class="portrait" src="/portrait.jpg" alt={`Portrait of ${profile.name}`} width="144" height="144" />
  <div class="plate">
    <p class="name">{profile.name}</p>
    <p class="tagline">{profile.tagline}</p>
    <div class="hire-row">
      <a class="hire" href="/about">About&nbsp;&rarr;</a>
      <a class="hire" href="/consulting">AI consulting&nbsp;&rarr;</a>
    </div>
  </div>
</div>

<style>
  .seam {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    pointer-events: none;
  }

  .portrait {
    width: 144px;
    height: 144px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    position: relative;
    z-index: 2;
    box-shadow:
      0 0 0 1px rgba(110, 103, 94, 0.5),
      0 10px 28px -10px rgba(0, 0, 0, 0.55);
  }

  /* a single warm surface under the identity, so the text never straddles
     the paper|coal seam — readable on either half, and on the mobile stack */
  .plate {
    position: relative;
    z-index: 1;
    margin-top: -36px;
    padding: 3.4rem 2.4rem 1.5rem;
    background: var(--paper);
    border: 1px solid var(--rule-ink);
    border-radius: 14px;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.6) inset,
      0 30px 70px -34px rgba(0, 0, 0, 0.6);
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
  }

  .name {
    font-family: var(--serif);
    font-size: 1.55rem;
    font-weight: 480;
    letter-spacing: 0.045em;
    color: var(--ink);
    margin: 0 0 0.35rem;
  }

  .tagline {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    margin: 0;
  }

  .hire-row {
    display: flex;
    gap: 1.6rem;
    margin-top: 1.15rem;
  }

  .hire {
    pointer-events: auto;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .hire:hover,
  .hire:focus-visible {
    color: var(--ink);
  }
</style>
