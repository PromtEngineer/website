---
import Base from '../layouts/Base.astro';
import Seam from '../components/Seam.astro';
import { profile } from '../data/profile';
---

<Base>
  <main class="split">
    <section class="half half--paper" aria-label="The scientist: research focus">
      <div class="content">
        <p class="label">The scientist</p>
        <p class="lede">{profile.scholar.summary}</p>
        <p class="stat">{profile.scholar.credentials}</p>
        <hr class="rule" />
        <ul class="list">
          {
            profile.focus.map((f) => (
              <li>
                <span class="item-title">{f.area}</span>
                <span class="item-meta">{f.note}</span>
              </li>
            ))
          }
        </ul>
        <nav class="links" aria-label="Scientist pages">
          <a class="more" href="/writing">Writing<span class="arrow">&nbsp;&rarr;</span></a>
          <a class="more" href="/research">Research<span class="arrow">&nbsp;&rarr;</span></a>
        </nav>
      </div>
    </section>

    <section class="half half--coal" aria-label="The builder: projects and teaching">
      <div class="content content--right">
        <p class="label label--mono">the_builder<span class="cursor" aria-hidden="true"></span></p>
        <p class="lede lede--mono">open source, open weights,<br />everything runs locally.</p>
        <p class="stat stat--mono">$ ls ~/work</p>
        <hr class="rule rule--bone" />
        <ul class="list">
          {
            profile.projects.map((p) => (
              <li>
                <a
                  class="item"
                  href={p.href}
                  target={p.href.startsWith('http') ? '_blank' : undefined}
                  rel={p.href.startsWith('http') ? 'noopener' : undefined}
                >
                  <span class="project-name">{p.name}</span>
                  <span class="item-meta item-meta--mono">{p.detail}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <nav class="links links--right" aria-label="Builder pages">
          <a class="more more--mono" href="/work">Projects<span class="arrow">&nbsp;&rarr;</span></a>
        </nav>
      </div>
    </section>

    <Seam />

    <footer class="strip">
      <a href="/about">about</a>
      <a href={profile.links.x}>x</a>
      <a href={profile.links.youtube}>youtube</a>
      <a href={profile.links.github}>github</a>
      <a href={profile.links.scholar}>scholar</a>
      <a href={profile.links.linkedin}>linkedin</a>
      <a href={`mailto:${profile.email}`}>email</a>
    </footer>
  </main>
</Base>

<style>
  .split {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100vh;
    min-height: 100svh;
  }

  .half {
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 5rem clamp(2rem, 6vw, 6rem);
  }

  /* a slow pool of light that drifts across the hovered half */
  .half::before {
    content: '';
    position: absolute;
    inset: -10%;
    opacity: 0;
    pointer-events: none;
    transform: translate3d(-3%, -2%, 0);
    transition:
      opacity 1.1s ease,
      transform 7s cubic-bezier(0.22, 0.61, 0.21, 1);
  }

  .half--paper::before {
    background: radial-gradient(80rem 55rem at 22% 35%, rgba(186, 117, 23, 0.07), transparent 62%);
  }

  .half--coal::before {
    background: radial-gradient(80rem 55rem at 78% 60%, rgba(64, 132, 214, 0.09), transparent 62%);
  }

  .half:hover::before {
    opacity: 1;
    transform: translate3d(3%, 2%, 0);
  }

  .half::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--noise);
    opacity: 0.04;
    pointer-events: none;
  }

  .half--paper {
    background: var(--paper);
    color: var(--ink);
    justify-content: flex-start;
  }

  .half--coal {
    background: var(--coal);
    color: var(--bone);
    justify-content: flex-end;
  }

  .content {
    position: relative;
    z-index: 1;
    max-width: 30rem;
    padding-right: clamp(2rem, 9vw, 9rem);
  }

  .content--right {
    text-align: right;
    padding-right: 0;
    padding-left: clamp(2rem, 9vw, 9rem);
  }

  /* ——— the scientist: typographic voice ——— */

  .label {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 1.4rem;
  }

  .lede {
    font-size: 1.32rem;
    font-weight: 420;
    line-height: 1.45;
    margin: 0 0 0.5rem;
    text-wrap: balance;
  }

  .stat {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin: 0 0 1.8rem;
  }

  .rule {
    border: 0;
    border-top: 1px solid var(--rule-ink);
    width: 2.25rem;
    margin: 0 0 1.8rem;
  }

  .list {
    list-style: none;
    margin: 0 0 2.2rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.05rem;
  }

  .item-title {
    display: block;
    font-size: 1.02rem;
    line-height: 1.4;
  }

  .item-meta {
    display: block;
    font-size: 0.78rem;
    color: var(--ink-soft);
    margin-top: 0.18rem;
  }

  .links {
    display: flex;
    gap: 1.6rem;
  }

  .links--right {
    justify-content: flex-end;
  }

  .more {
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    margin: 0;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .more:hover,
  .more:focus-visible {
    color: var(--ink);
  }

  .arrow {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .more:hover .arrow,
  .more:focus-visible .arrow {
    transform: translateX(4px);
  }

  /* ——— the builder: terminal voice ——— */

  .label--mono {
    font-family: var(--mono);
    text-transform: none;
    letter-spacing: 0.04em;
    font-size: 0.78rem;
    color: var(--bone-soft);
  }

  .cursor {
    display: inline-block;
    width: 0.52em;
    height: 1.05em;
    background: var(--phosphor);
    margin-left: 0.35em;
    vertical-align: -0.18em;
    animation: blink 1.15s steps(1) infinite;
  }

  .lede--mono {
    font-family: var(--mono);
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1.7;
    letter-spacing: 0.01em;
  }

  .stat--mono {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--bone-soft);
  }

  .rule--bone {
    border-top-color: var(--rule-bone);
  }

  .content--right .rule {
    margin-left: auto;
  }

  .item {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .project-name {
    display: block;
    font-family: var(--mono);
    font-size: 0.92rem;
    color: var(--bone);
    transition: color 0.25s ease;
  }

  .item:hover .project-name,
  .item:focus-visible .project-name {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--rule-bone);
  }

  .item:focus-visible {
    outline: 1px solid var(--bone-soft);
    outline-offset: 4px;
  }

  .item-meta--mono {
    font-family: var(--mono);
    color: var(--bone-soft);
    font-size: 0.74rem;
  }

  .more--mono {
    font-family: var(--mono);
    color: var(--bone-soft);
  }

  .more--mono:hover,
  .more--mono:focus-visible {
    color: var(--bone);
  }

  /* ——— footer strip ——— */

  /* no transform / z-index, or the blend mode stops working */
  .strip {
    position: absolute;
    bottom: 1.4rem;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }

  .strip a {
    color: #fff;
    mix-blend-mode: difference;
    text-decoration: none;
    opacity: 0.62;
    transition: opacity 0.25s ease;
  }

  .strip a:hover,
  .strip a:focus-visible {
    opacity: 1;
  }

  /* ——— entrance ——— */

  .content > * {
    opacity: 0;
    transform: translateY(10px);
    animation: rise 0.8s cubic-bezier(0.22, 0.61, 0.21, 1) forwards;
  }

  .content > *:nth-child(1) { animation-delay: 0.05s; }
  .content > *:nth-child(2) { animation-delay: 0.13s; }
  .content > *:nth-child(3) { animation-delay: 0.21s; }
  .content > *:nth-child(4) { animation-delay: 0.29s; }
  .content > *:nth-child(5) { animation-delay: 0.37s; }
  .content > *:nth-child(6) { animation-delay: 0.45s; }

  @keyframes rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes blink {
    0%, 55% { opacity: 1; }
    56%, 100% { opacity: 0; }
  }

  /* ——— mobile: the split becomes a stack ——— */

  @media (max-width: 768px) {
    .split {
      display: flex;
      flex-direction: column;
    }

    .half {
      padding: 3.5rem 2rem;
      justify-content: center;
    }

    .half--paper {
      order: 1;
      padding-bottom: 7.5rem;
    }

    /* flex `order` also reorders painting, so the coal half (order 3) would
       paint over the seam; z-index is safe here because on mobile the
       nameplate sits fully on coal and doesn't need the blend trick */
    .split :global(.seam) {
      order: 2;
      position: relative;
      inset: auto;
      z-index: 1;
      align-self: center;
      margin: -4.5rem 0 -7.25rem;
    }

    .split :global(.seam .name),
    .split :global(.seam .tagline),
    .split :global(.seam .hire) {
      mix-blend-mode: normal;
      color: var(--bone);
    }

    .half--coal {
      order: 3;
      padding-top: 9.5rem;
    }

    .strip {
      order: 4;
      position: static;
      justify-content: center;
      flex-wrap: wrap;
      padding: 1.3rem 1rem 1.6rem;
      background: var(--coal);
    }

    .content,
    .content--right {
      padding: 0;
      max-width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .half::before,
    .arrow,
    .more,
    .project-name {
      transition: none;
    }

    .content > * {
      opacity: 1;
      transform: none;
      animation: none;
    }

    .cursor {
      animation: none;
    }
  }
</style>
