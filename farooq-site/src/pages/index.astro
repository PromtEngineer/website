---
import Base from '../layouts/Base.astro';
import Seam from '../components/Seam.astro';
import { profile } from '../data/profile';
---

<Base>
  <main class="split">
    <section class="half half--paper" aria-label="The scientist: research focus">
      <div class="content">
        <p class="label">The scientist</p>
        <p class="lede">{profile.scholar.summary}</p>
        <p class="stat">PhD, applied machine learning &middot; <a class="stat-link" href={profile.links.scholar} target="_blank" rel="noopener">{profile.scholar.citations} citations</a> &middot; h-index {profile.scholar.hIndex}</p>
        <hr class="rule" />
        <ul class="list">
          {
            profile.focus.map((f) => (
              <li>
                <span class="item-title">{f.area}</span>
                <span class="item-meta">{f.note}</span>
              </li>
            ))
          }
        </ul>
        <nav class="links" aria-label="Scientist pages">
          <a class="more" href="/writing">Writing<span class="arrow">&nbsp;&rarr;</span></a>
        </nav>
      </div>
    </section>

    <section class="half half--coal" aria-label="The builder: projects and teaching">
      <div class="content content--right">
        <p class="label label--mono">the_builder<span class="cursor" aria-hidden="true"></span></p>
        <p class="lede lede--mono">open source, open weights,<br />everything runs locally.</p>
        <p class="stat stat--mono">$ ls ~/work</p>
        <hr class="rule rule--bone" />
        <ul class="list">
          {
            profile.projects.map((p) => (
              <li>
                <a
                  class="item"
                  href={p.href}
                  target={p.href.startsWith('http') ? '_blank' : undefined}
                  rel={p.href.startsWith('http') ? 'noopener' : undefined}
                >
                  <span class="project-name">{p.name}</span>
                  <span class="item-meta item-meta--mono">{p.detail}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <nav class="links links--right" aria-label="Builder pages">
          <a class="more more--mono" href="/work">Projects<span class="arrow">&nbsp;&rarr;</span></a>
        </nav>
      </div>
    </section>

    <Seam />

    <footer class="strip">
      <a href={profile.links.x} aria-label="X" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      <a href={profile.links.youtube} aria-label="YouTube" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .501 6.186C0 8.07 0 12 0 12s0 3.93.501 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.377.505 9.377.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
      </a>
      <a href={profile.links.github} aria-label="GitHub" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
      </a>
      <a href={profile.links.scholar} aria-label="Google Scholar" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"/></svg>
      </a>
      <a href={profile.links.linkedin} aria-label="LinkedIn" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <a href={`mailto:${profile.email}`} aria-label="Email">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
      </a>
      <a href="/rss.xml" aria-label="RSS feed">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.199 24C19.199 13.467 10.533 4.8 0 4.8V0c13.165 0 24 10.835 24 24h-4.801zM3.291 17.415a3.3 3.3 0 0 0-3.291 3.295 3.291 3.291 0 1 0 6.581 0 3.3 3.3 0 0 0-3.29-3.295zM0 8.876v4.654c5.665 0 10.27 4.604 10.27 10.27h4.654C14.924 15.738 8.262 9.076 0 8.876z"/></svg>
      </a>
    </footer>
  </main>
</Base>

<style>
  .split {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100vh;
    min-height: 100svh;
  }

  .half {
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 5rem clamp(2rem, 6vw, 6rem);
  }

  /* a slow pool of light that drifts across the hovered half */
  .half::before {
    content: '';
    position: absolute;
    inset: -10%;
    opacity: 0;
    pointer-events: none;
    transform: translate3d(-3%, -2%, 0);
    transition:
      opacity 1.1s ease,
      transform 7s cubic-bezier(0.22, 0.61, 0.21, 1);
  }

  .half--paper::before {
    background: radial-gradient(80rem 55rem at 22% 35%, rgba(186, 117, 23, 0.07), transparent 62%);
  }

  .half--coal::before {
    background: radial-gradient(80rem 55rem at 78% 60%, rgba(64, 132, 214, 0.09), transparent 62%);
  }

  .half:hover::before {
    opacity: 1;
    transform: translate3d(3%, 2%, 0);
  }

  .half::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--noise);
    opacity: 0.04;
    pointer-events: none;
  }

  .half--paper {
    background: var(--paper);
    color: var(--ink);
    justify-content: flex-start;
  }

  .half--coal {
    background: var(--coal);
    color: var(--bone);
    justify-content: flex-end;
  }

  .content {
    position: relative;
    z-index: 1;
    max-width: 30rem;
    padding-right: clamp(2rem, 9vw, 9rem);
  }

  .content--right {
    text-align: right;
    padding-right: 0;
    padding-left: clamp(2rem, 9vw, 9rem);
  }

  /* ——— the scientist: typographic voice ——— */

  .label {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 1.4rem;
  }

  .lede {
    font-size: 1.32rem;
    font-weight: 420;
    line-height: 1.45;
    margin: 0 0 0.5rem;
    text-wrap: balance;
  }

  .stat {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin: 0 0 1.8rem;
  }

  .stat-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    text-decoration-color: var(--rule-ink);
    transition: text-decoration-color 0.25s ease;
  }

  .stat-link:hover,
  .stat-link:focus-visible {
    text-decoration-color: var(--ink);
  }

  .rule {
    border: 0;
    border-top: 1px solid var(--rule-ink);
    width: 2.25rem;
    margin: 0 0 1.8rem;
  }

  .list {
    list-style: none;
    margin: 0 0 2.2rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.05rem;
  }

  .item-title {
    display: block;
    font-size: 1.02rem;
    line-height: 1.4;
  }

  .item-meta {
    display: block;
    font-size: 0.78rem;
    color: var(--ink-soft);
    margin-top: 0.18rem;
  }

  .links {
    display: flex;
    gap: 1.6rem;
  }

  .links--right {
    justify-content: flex-end;
  }

  .more {
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    margin: 0;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .more:hover,
  .more:focus-visible {
    color: var(--ink);
  }

  .arrow {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .more:hover .arrow,
  .more:focus-visible .arrow {
    transform: translateX(4px);
  }

  /* ——— the builder: terminal voice ——— */

  .label--mono {
    font-family: var(--mono);
    text-transform: none;
    letter-spacing: 0.04em;
    font-size: 0.78rem;
    color: var(--bone-soft);
  }

  .cursor {
    display: inline-block;
    width: 0.52em;
    height: 1.05em;
    background: var(--phosphor);
    margin-left: 0.35em;
    vertical-align: -0.18em;
    animation: blink 1.15s steps(1) infinite;
  }

  .lede--mono {
    font-family: var(--mono);
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1.7;
    letter-spacing: 0.01em;
  }

  .stat--mono {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--bone-soft);
  }

  .rule--bone {
    border-top-color: var(--rule-bone);
  }

  .content--right .rule {
    margin-left: auto;
  }

  .item {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .project-name {
    display: block;
    font-family: var(--mono);
    font-size: 0.92rem;
    color: var(--bone);
    transition: color 0.25s ease;
  }

  .item:hover .project-name,
  .item:focus-visible .project-name {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--rule-bone);
  }

  .item:focus-visible {
    outline: 1px solid var(--bone-soft);
    outline-offset: 4px;
  }

  .item-meta--mono {
    font-family: var(--mono);
    color: var(--bone-soft);
    font-size: 0.74rem;
  }

  .more--mono {
    font-family: var(--mono);
    color: var(--bone-soft);
  }

  .more--mono:hover,
  .more--mono:focus-visible {
    color: var(--bone);
  }

  /* ——— footer strip ——— */

  /* a floating paper pill, like the nameplate, so the icons never straddle
     the paper|coal seam. no mix-blend, so transform is safe here now. */
  .strip {
    position: absolute;
    bottom: 1.6rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.4rem 0.7rem;
    background: var(--paper);
    border: 1px solid var(--rule-ink);
    border-radius: 999px;
    box-shadow: 0 20px 44px -24px rgba(0, 0, 0, 0.55);
  }

  .strip a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .strip a:hover,
  .strip a:focus-visible {
    color: var(--ink);
    background: rgba(28, 26, 23, 0.06);
  }

  .strip svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
    display: block;
  }

  /* ——— entrance ——— */

  .content > * {
    opacity: 0;
    transform: translateY(10px);
    animation: rise 0.8s cubic-bezier(0.22, 0.61, 0.21, 1) forwards;
  }

  .content > *:nth-child(1) { animation-delay: 0.05s; }
  .content > *:nth-child(2) { animation-delay: 0.13s; }
  .content > *:nth-child(3) { animation-delay: 0.21s; }
  .content > *:nth-child(4) { animation-delay: 0.29s; }
  .content > *:nth-child(5) { animation-delay: 0.37s; }
  .content > *:nth-child(6) { animation-delay: 0.45s; }

  @keyframes rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes blink {
    0%, 55% { opacity: 1; }
    56%, 100% { opacity: 0; }
  }

  /* ——— mobile: the split becomes a stack ——— */

  @media (max-width: 768px) {
    .split {
      display: flex;
      flex-direction: column;
    }

    .half {
      padding: 3.5rem 2rem;
      justify-content: center;
    }

    .half--paper {
      order: 1;
      padding-bottom: 7.5rem;
    }

    /* flex `order` also reorders painting, so the coal half (order 3) would
       paint over the seam; z-index keeps the plate on top. The plate carries
       its own paper surface, so no blend trick or color override is needed. */
    .split :global(.seam) {
      order: 2;
      position: relative;
      inset: auto;
      z-index: 1;
      align-self: center;
      margin: -4.5rem 0 -7.25rem;
    }

    .half--coal {
      order: 3;
      padding-top: 9.5rem;
    }

    /* mobile is a single stack, nothing straddles a seam: drop the pill and
       let the footer be a plain coal bar with light icons */
    .strip {
      order: 4;
      position: static;
      transform: none;
      left: auto;
      justify-content: center;
      gap: 0.4rem;
      flex-wrap: wrap;
      padding: 1.4rem 1rem 1.8rem;
      background: var(--coal);
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }

    .strip a {
      color: var(--bone-soft);
    }

    .strip a:hover,
    .strip a:focus-visible {
      color: var(--bone);
      background: rgba(242, 239, 233, 0.1);
    }

    .content,
    .content--right {
      padding: 0;
      max-width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .half::before,
    .arrow,
    .more,
    .project-name {
      transition: none;
    }

    .content > * {
      opacity: 1;
      transform: none;
      animation: none;
    }

    .cursor {
      animation: none;
    }
  }
</style>
