---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
---

<Base title={`About · ${profile.name}`}>
  <main class="page">
    <a class="back" href="/">&larr; home</a>

    <header class="head">
      <img class="portrait" src="/portrait.jpg" alt={`Portrait of ${profile.name}`} width="72" height="72" />
      <div>
        <p class="label">About</p>
        <h1 class="name">{profile.name}</h1>
      </div>
    </header>

    <p class="intro">
      I'm a researcher and builder at heart, with over a decade of experience building and
      scaling machine learning systems. That journey runs from wearable sensors to
      retrieval-augmented generation and, today, scalable agentic systems.
    </p>
    <p class="intro">
      Before that, I earned a PhD in applied machine learning, specializing in wearable sensors
      and biomedical signal processing. My research has been cited more than 2,000 times, and
      along the way I published a book and hold a patent. You can browse the work on
      <a href={profile.links.scholar}>Google Scholar</a>.
    </p>
    <p class="intro">
      I'm deeply committed to open source. I created
      <a href="https://github.com/PromtEngineer/localGPT">localGPT</a>, one of the first
      open-source retrieval-augmented generation projects for secure, private document
      interaction, now past 22,000 stars on GitHub. Today I'm building
      <a href="https://whryte.com">whryte</a>, a fully offline voice-to-text app for the Mac.
    </p>
    <p class="intro">
      These days, I help companies build agentic systems and evolve with them. I have worked
      with startups as a consultant and an advisor, and I love exploring new applications of
      agentic systems. On my YouTube channel,
      <a href={profile.links.youtube}>Prompt Engineering</a>, I share what I learn along the way
      with more than 200,000 subscribers.
    </p>

    <nav class="links" aria-label="Continue">
      <a class="more" href="/writing">Writing<span class="arrow">&nbsp;&rarr;</span></a>
      <a class="more" href={`mailto:${profile.email}?subject=AI%20consulting`}>AI consulting<span class="arrow">&nbsp;&rarr;</span></a>
    </nav>
  </main>
</Base>

<style>
  .page {
    min-height: 100vh;
    min-height: 100svh;
    background: var(--paper);
    color: var(--ink);
    padding: 3rem clamp(1.5rem, 6vw, 4rem) 5rem;
    max-width: 44rem;
    margin: 0 auto;
  }

  .back {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .back:hover,
  .back:focus-visible {
    color: var(--ink);
  }

  .head {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin: 3rem 0 2.2rem;
  }

  .portrait {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 1px rgba(110, 103, 94, 0.5);
  }

  .label {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 0.3rem;
  }

  .name {
    font-family: var(--serif);
    font-size: 1.8rem;
    font-weight: 480;
    letter-spacing: 0.02em;
    margin: 0;
  }

  .intro {
    font-size: 1.08rem;
    line-height: 1.65;
    margin: 0 0 1.2rem;
    max-width: 38rem;
  }

  .intro a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: var(--rule-ink);
    transition: text-decoration-color 0.25s ease;
  }

  .intro a:hover,
  .intro a:focus-visible {
    text-decoration-color: var(--ink);
  }

  /* ——— continue ——— */

  .links {
    display: flex;
    gap: 1.8rem;
    margin-top: 3rem;
  }

  .more {
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .more:hover,
  .more:focus-visible {
    color: var(--ink);
  }

  .arrow {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .more:hover .arrow,
  .more:focus-visible .arrow {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .arrow,
    .more {
      transition: none;
    }
  }
</style>
