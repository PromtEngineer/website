---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
---

<Base title={`Work · ${profile.name}`}>
  <main class="hold hold--coal">
    <p class="label">the_builder</p>
    <p class="line">$ projects --all<span class="cursor" aria-hidden="true"></span></p>
    <p class="line line--soft">
      compiling… meanwhile: <a href={profile.links.github}>github</a> · <a href={profile.links.youtube}>youtube</a>
    </p>
    <a class="back" href="/">&larr; home</a>
  </main>
</Base>

<style>
  .hold {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    text-align: center;
    padding: 2rem;
  }

  .hold--coal {
    background: var(--coal);
    color: var(--bone);
  }

  .label {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--bone-soft);
    margin: 0 0 1rem;
  }

  .line {
    font-family: var(--mono);
    font-size: 1.05rem;
    margin: 0;
  }

  .line--soft {
    font-size: 0.8rem;
    color: var(--bone-soft);
  }

  .cursor {
    display: inline-block;
    width: 0.52em;
    height: 1.05em;
    background: var(--phosphor);
    margin-left: 0.35em;
    vertical-align: -0.18em;
    animation: blink 1.15s steps(1) infinite;
  }

  @keyframes blink {
    0%, 55% { opacity: 1; }
    56%, 100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }

  .back {
    margin-top: 2.5rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--bone-soft);
    text-decoration: none;
  }

  .back:hover {
    color: var(--bone);
  }
</style>
